# 환경 변수 설정 파일 예시
# 실제 사용 시 이 파일을 .env로 복사하고 값을 채워주세요

# MJPEG 스트림 URL (라즈베리파이 IP 주소로 변경)
MJPEG_STREAM_URL=http://192.168.x.x:5000/video_feed

# Google Maps API Key (Google Cloud Console에서 발급)
# 보안 설정:
#   - Application restrictions: Android apps
#   - Package name: com.example.smoke_detection_app
#   - SHA-1 fingerprint 등록
#   - API restrictions: Maps SDK for Android만 허용
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
